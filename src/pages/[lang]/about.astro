---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { languages, translations, type Language } from "../../i18n";
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Language;
const t = translations[lang];
---
<SiteLayout title={`${t.about} — ${t.brand}`} currentPage="about" lang={lang}>
  <div class="page-intro">
    <h1>{t.aboutTitle}</h1>
    <p class="intro">{t.aboutIntro}</p>
  </div>
  {t.aboutSections.map(section => <section aria-labelledby={`${section.id}-heading`}>
    <h2 id={`${section.id}-heading`}>{section.title}</h2>
    <p>{section.text}</p>
  </section>)}
  <section aria-labelledby="participation-heading">
    <h2 id="participation-heading">{t.participationTitle}</h2>
    <p>{t.participationText}</p>
    <p><a href={t.participationUrl}>{t.participationLink}</a></p>
  </section>
</SiteLayout>
