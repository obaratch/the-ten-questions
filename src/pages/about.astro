---
import { defaultLanguage, pageUrl } from "../i18n";
const destination = pageUrl(defaultLanguage, "about");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="refresh" content={`0;url=${destination}`}>
    <link rel="canonical" href={destination}>
    <title>The Ten Questions</title>
  </head>
  <body><a href={destination}>Continue in English</a></body>
</html>
