---
import { translations, type Language } from "../i18n";
interface Props {
  lang: Language;
  id: string;
  question: { text: Partial<Record<Language, string>>; rationale?: Record<string, string> };
  position?: number;
}
const { id, question, position, lang } = Astro.props;
const text = question.text[lang];
if (!text?.trim()) throw new Error(`Missing ${lang} translation for ${id}`);
const t = translations[lang];
const rationales = question.rationale ?? {};
const rationaleLanguage = [lang, "en", ...Object.keys(rationales)].find(language => rationales[language]?.trim());
const rationale = rationaleLanguage ? rationales[rationaleLanguage] : undefined;
---
<li class="question-card" id={id}>
  <h3>{position !== undefined && <span class="question-number">{String(position + 1).padStart(2, "0")}</span>}<span class="question-id">{id}</span></h3>
  <p lang={lang}>{text}</p>
  <details class="question-rationale">
    <summary>{t.rationaleLabel}</summary>
    <div class="rationale-content">
      {rationale && rationaleLanguage !== lang && <p class="translation-notice">{t.untranslated}</p>}
      {rationale ? <p class="rationale-text" lang={rationaleLanguage}>{rationale}</p> : <p>{t.noRationale}</p>}
    </div>
  </details>
</li>
